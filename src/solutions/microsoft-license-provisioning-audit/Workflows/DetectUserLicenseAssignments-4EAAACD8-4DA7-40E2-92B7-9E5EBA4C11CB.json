{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mlpa_M365LN_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "TenantID (mlpa_TenantID)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_TenantID"
          }
        },
        "ClientID (mlpa_ClientID)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_ClientID"
          }
        },
        "Secret (mlpa_Secret)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_Secret"
          }
        },
        "GraphBaseUrl (mlpa_GraphBaseUrl)": {
          "defaultValue": "https://graph.microsoft.com",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_GraphBaseUrl"
          }
        },
        "AuthorityUrl (mlpa_AuthorityUrl)": {
          "defaultValue": "https://login.microsoftonline.com",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_AuthorityUrl"
          }
        },
        "PollOverlapMinutes (mlpa_PollOverlapMinutes)": {
          "defaultValue": 30,
          "type": "Int",
          "metadata": {
            "schemaName": "mlpa_PollOverlapMinutes"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 15
          }
        }
      },
      "actions": {
        "List_UserAudit_Checkpoint": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mlpa_detectioncheckpoints",
              "$filter": "mlpa_name eq 'UserAudit'"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Initialize_Watermark": {
          "runAfter": {
            "List_UserAudit_Checkpoint": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varWatermark",
                "type": "string",
                "value": "@if(greater(length(body('List_UserAudit_Checkpoint')?['value']),0),first(body('List_UserAudit_Checkpoint')?['value'])?['mlpa_lastprocessedutc'],utcNow())"
              }
            ]
          }
        },
        "Initialize_Overlap": {
          "runAfter": {
            "Initialize_Watermark": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varWatermarkWithOverlap",
                "type": "string",
                "value": "@if(greater(length(body('List_UserAudit_Checkpoint')?['value']),0),addMinutes(variables('varWatermark'),mul(-1,int(parameters('PollOverlapMinutes (mlpa_PollOverlapMinutes)')))),variables('varWatermark'))"
              }
            ]
          }
        },
        "HTTP_DirectoryAudits": {
          "runAfter": {
            "Initialize_Overlap": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('GraphBaseUrl (mlpa_GraphBaseUrl)')}/v1.0/auditLogs/directoryAudits?$filter=activityDisplayName eq 'Change user license' and activityDateTime ge @{variables('varWatermarkWithOverlap')}&$orderby=activityDateTime asc",
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "@parameters('AuthorityUrl (mlpa_AuthorityUrl)')",
              "tenant": "@parameters('TenantID (mlpa_TenantID)')",
              "audience": "@parameters('GraphBaseUrl (mlpa_GraphBaseUrl)')",
              "clientId": "@parameters('ClientID (mlpa_ClientID)')",
              "secret": "@parameters('Secret (mlpa_Secret)')"
            }
          }
        },
        "Parse_DirectoryAudits": {
          "runAfter": {
            "HTTP_DirectoryAudits": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('HTTP_DirectoryAudits')",
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "activityDateTime": {
                        "type": "string"
                      },
                      "initiatedBy": {
                        "type": "object"
                      },
                      "targetResources": {
                        "type": "array"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "For_Each_Audit": {
          "runAfter": {
            "Parse_DirectoryAudits": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('Parse_DirectoryAudits')?['value']",
          "actions": {
            "List_Event_BySourceId": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "mlpa_provisioningevents",
                  "$filter": "mlpa_sourceid eq '@{items('For_Each_Audit')?['id']}'"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "If_Not_Deduped": {
              "runAfter": {
                "List_Event_BySourceId": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@length(body('List_Event_BySourceId')?['value'])",
                  0
                ]
              },
              "actions": {
                "Create_UserLicenseAssigned_Event": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps_1",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "mlpa_provisioningevents",
                      "item": {
                        "mlpa_name": "User license assignment @ @{items('For_Each_Audit')?['activityDateTime']}",
                        "mlpa_sourceid": "@{items('For_Each_Audit')?['id']}",
                        "mlpa_eventtype": 205410003,
                        "mlpa_targetuserupn": "@{coalesce(first(items('For_Each_Audit')?['targetResources'])?['userPrincipalName'],'')}",
                        "mlpa_targetuserid": "@{coalesce(first(items('For_Each_Audit')?['targetResources'])?['id'],'')}",
                        "mlpa_initiatedby": "@{coalesce(items('For_Each_Audit')?['initiatedBy']?['user']?['userPrincipalName'],items('For_Each_Audit')?['initiatedBy']?['app']?['displayName'],'system')}",
                        "mlpa_eventtimeutc": "@{items('For_Each_Audit')?['activityDateTime']}",
                        "mlpa_detectedon": "@utcNow()",
                        "mlpa_notificationstatus": 205410011
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        },
        "Upsert_UserAudit_Checkpoint": {
          "runAfter": {
            "For_Each_Audit": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "greater": [
              "@length(body('List_UserAudit_Checkpoint')?['value'])",
              0
            ]
          },
          "actions": {
            "Update_UserAudit_Checkpoint": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "mlpa_detectioncheckpoints",
                  "recordId": "@first(body('List_UserAudit_Checkpoint')?['value'])?['mlpa_detectioncheckpointid']",
                  "item": {
                    "mlpa_lastprocessedutc": "@utcNow()",
                    "mlpa_lastrunstatus": 205410022
                  }
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {
              "Create_UserAudit_Checkpoint": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps_1",
                    "operationId": "CreateRecord",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "mlpa_detectioncheckpoints",
                    "item": {
                      "mlpa_name": "UserAudit",
                      "mlpa_lastprocessedutc": "@utcNow()",
                      "mlpa_lastrunstatus": 205410022
                    }
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          }
        }
      }
    },
    "templateName": "Detect User License Assignments"
  },
  "schemaVersion": "1.0.0.0"
}
