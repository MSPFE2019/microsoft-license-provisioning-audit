{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mlpa_M365LN_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "TenantID (mlpa_TenantID)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_TenantID"
          }
        },
        "ClientID (mlpa_ClientID)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_ClientID"
          }
        },
        "Secret (mlpa_Secret)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_Secret"
          }
        },
        "GraphBaseUrl (mlpa_GraphBaseUrl)": {
          "defaultValue": "https://graph.microsoft.com",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_GraphBaseUrl"
          }
        },
        "AuthorityUrl (mlpa_AuthorityUrl)": {
          "defaultValue": "https://login.microsoftonline.com",
          "type": "String",
          "metadata": {
            "schemaName": "mlpa_AuthorityUrl"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Hour",
            "interval": 1
          }
        }
      },
      "actions": {
        "List_Baseline_Checkpoint": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mlpa_detectioncheckpoints",
              "$filter": "mlpa_name eq 'TenantBaselineSeeded'"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Initialize_BaselineSeeded": {
          "runAfter": {
            "List_Baseline_Checkpoint": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varBaselineSeeded",
                "type": "boolean",
                "value": "@greater(length(body('List_Baseline_Checkpoint')?['value']),0)"
              }
            ]
          }
        },
        "HTTP_SubscribedSkus": {
          "runAfter": {
            "Initialize_BaselineSeeded": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('GraphBaseUrl (mlpa_GraphBaseUrl)')}/v1.0/subscribedSkus",
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "@parameters('AuthorityUrl (mlpa_AuthorityUrl)')",
              "tenant": "@parameters('TenantID (mlpa_TenantID)')",
              "audience": "@parameters('GraphBaseUrl (mlpa_GraphBaseUrl)')",
              "clientId": "@parameters('ClientID (mlpa_ClientID)')",
              "secret": "@parameters('Secret (mlpa_Secret)')"
            }
          }
        },
        "Parse_SubscribedSkus": {
          "runAfter": {
            "HTTP_SubscribedSkus": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('HTTP_SubscribedSkus')",
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "skuId": {
                        "type": "string"
                      },
                      "skuPartNumber": {
                        "type": "string"
                      },
                      "consumedUnits": {
                        "type": "integer"
                      },
                      "prepaidUnits": {
                        "type": "object",
                        "properties": {
                          "enabled": {
                            "type": "integer"
                          },
                          "suspended": {
                            "type": "integer"
                          },
                          "warning": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "For_Each_SKU": {
          "runAfter": {
            "Parse_SubscribedSkus": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('Parse_SubscribedSkus')?['value']",
          "actions": {
            "List_Snapshot_BySkuId": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "mlpa_licensesnapshots",
                  "$filter": "mlpa_skuid eq '@{items('For_Each_SKU')?['skuId']}'"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "If_Existing_Snapshot": {
              "runAfter": {
                "List_Snapshot_BySkuId": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "greater": [
                  "@length(body('List_Snapshot_BySkuId')?['value'])",
                  0
                ]
              },
              "actions": {
                "If_Enabled_Increased": {
                  "runAfter": {},
                  "type": "If",
                  "expression": {
                    "greater": [
                      "@int(items('For_Each_SKU')?['prepaidUnits']?['enabled'])",
                      "@int(first(body('List_Snapshot_BySkuId')?['value'])?['mlpa_enabledunits'])"
                    ]
                  },
                  "actions": {
                    "Create_TenantSkuIncrease_Event": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_1",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "mlpa_provisioningevents",
                          "item": {
                            "mlpa_name": "@{items('For_Each_SKU')?['skuPartNumber']} increase @ @{utcNow()}",
                            "mlpa_sourceid": "@{items('For_Each_SKU')?['skuId']}-@{items('For_Each_SKU')?['prepaidUnits']?['enabled']}-@{ticks(utcNow())}",
                            "mlpa_eventtype": 205410001,
                            "mlpa_skuid": "@{items('For_Each_SKU')?['skuId']}",
                            "mlpa_skupartnumber": "@{items('For_Each_SKU')?['skuPartNumber']}",
                            "mlpa_previousunits": "@{int(first(body('List_Snapshot_BySkuId')?['value'])?['mlpa_enabledunits'])}",
                            "mlpa_newunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['enabled'])}",
                            "mlpa_delta": "@{sub(int(items('For_Each_SKU')?['prepaidUnits']?['enabled']),int(first(body('List_Snapshot_BySkuId')?['value'])?['mlpa_enabledunits']))}",
                            "mlpa_eventtimeutc": "@utcNow()",
                            "mlpa_detectedon": "@utcNow()",
                            "mlpa_notificationstatus": 205410011
                          }
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                },
                "Update_Snapshot": {
                  "runAfter": {
                    "If_Enabled_Increased": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps_1",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "mlpa_licensesnapshots",
                      "recordId": "@first(body('List_Snapshot_BySkuId')?['value'])?['mlpa_licensesnapshotid']",
                      "item": {
                        "mlpa_skupartnumber": "@{items('For_Each_SKU')?['skuPartNumber']}",
                        "mlpa_friendlyname": "@{items('For_Each_SKU')?['skuPartNumber']}",
                        "mlpa_enabledunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['enabled'])}",
                        "mlpa_suspendedunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['suspended'])}",
                        "mlpa_warningunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['warning'])}",
                        "mlpa_consumedunits": "@{int(items('For_Each_SKU')?['consumedUnits'])}",
                        "mlpa_lastcheckedon": "@utcNow()"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "else": {
                "actions": {
                  "Create_NewSku_Event_When_Baseline_Exists": {
                    "runAfter": {},
                    "type": "If",
                    "expression": {
                      "equals": [
                        "@variables('varBaselineSeeded')",
                        true
                      ]
                    },
                    "actions": {
                      "Create_TenantSkuNew_Event": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps_1",
                            "operationId": "CreateRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "mlpa_provisioningevents",
                            "item": {
                              "mlpa_name": "@{items('For_Each_SKU')?['skuPartNumber']} new SKU @ @{utcNow()}",
                              "mlpa_sourceid": "@{items('For_Each_SKU')?['skuId']}-new-@{ticks(utcNow())}",
                              "mlpa_eventtype": 205410002,
                              "mlpa_skuid": "@{items('For_Each_SKU')?['skuId']}",
                              "mlpa_skupartnumber": "@{items('For_Each_SKU')?['skuPartNumber']}",
                              "mlpa_previousunits": 0,
                              "mlpa_newunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['enabled'])}",
                              "mlpa_delta": "@{int(items('For_Each_SKU')?['prepaidUnits']?['enabled'])}",
                              "mlpa_eventtimeutc": "@utcNow()",
                              "mlpa_detectedon": "@utcNow()",
                              "mlpa_notificationstatus": 205410011
                            }
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    },
                    "else": {
                      "actions": {}
                    }
                  },
                  "Create_Snapshot": {
                    "runAfter": {
                      "Create_NewSku_Event_When_Baseline_Exists": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps_1",
                        "operationId": "CreateRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "mlpa_licensesnapshots",
                        "item": {
                          "mlpa_skuid": "@{items('For_Each_SKU')?['skuId']}",
                          "mlpa_skupartnumber": "@{items('For_Each_SKU')?['skuPartNumber']}",
                          "mlpa_friendlyname": "@{items('For_Each_SKU')?['skuPartNumber']}",
                          "mlpa_enabledunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['enabled'])}",
                          "mlpa_suspendedunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['suspended'])}",
                          "mlpa_warningunits": "@{int(items('For_Each_SKU')?['prepaidUnits']?['warning'])}",
                          "mlpa_consumedunits": "@{int(items('For_Each_SKU')?['consumedUnits'])}",
                          "mlpa_lastcheckedon": "@utcNow()"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              }
            }
          }
        },
        "Create_Baseline_Checkpoint": {
          "runAfter": {
            "For_Each_SKU": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "equals": [
              "@variables('varBaselineSeeded')",
              false
            ]
          },
          "actions": {
            "Create_TenantBaselineSeeded_Row": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "mlpa_detectioncheckpoints",
                  "item": {
                    "mlpa_name": "TenantBaselineSeeded",
                    "mlpa_lastrunstatus": 205410022,
                    "mlpa_lastprocessedutc": "@utcNow()"
                  }
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "templateName": "Detect Tenant License Provisioning"
  },
  "schemaVersion": "1.0.0.0"
}
